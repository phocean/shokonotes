{
  "sourceLanguage": "en",
  "strings": {
    "Quit Shokonotes when closing the library window": {
      "comment": "Checkbox label in Settings > General > Window. Off by default; when on, closing the library window quits the app. \"Shokonotes\" is the app name and is never translated.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit Shokonotes when closing the library window"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter Shokonotes à la fermeture de la fenêtre de bibliothèque"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shokonotes beim Schließen des Bibliotheksfensters beenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir de Shokonotes al cerrar la ventana de la biblioteca"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci da Shokonotes alla chiusura della finestra della libreria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリウインドウを閉じるときにShokonotesを終了"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리 윈도우를 닫을 때 Shokonotes 종료"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerrar o Shokonotes ao fechar a janela da biblioteca"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭资料库窗口时退出 Shokonotes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершать Shokonotes при закрытии окна библиотеки"
          }
        }
      }
    },
    "All Notes": {
      "comment": "Noun phrase. Fixed sidebar row (macOS and iOS) that lists every note in the library, and the same words are reused as the note list's collection title above the list. Sidebar row: keep short, truncates past roughly 20 characters.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All Notes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les notes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Notizen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las notas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le note"

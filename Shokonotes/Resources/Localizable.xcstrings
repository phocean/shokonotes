    "Created in your notes folder.": {
      "comment": "Help text under the name field of the iOS new-folder alert: the folder will be created inside the library folder. \"notes folder\" is that library folder, same wording as the settings row of that name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created in your notes folder."
          }

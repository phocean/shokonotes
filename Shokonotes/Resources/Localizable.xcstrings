    },
    "Show the inbox count on the app icon": {
      "comment": "Toggle label in iOS Settings — the iOS counterpart of the macOS Dock badge setting. When on, the number of notes in the Inbox is drawn as a badge on the app icon on the Home Screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",

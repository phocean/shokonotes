    "Use \"%@\" instead": {
      "comment": "One line offered under the tag field when the tag being typed differs only in case or form from one already in the library; clicking it adopts the existing tag. %@ is that existing tag's name. Verb phrase, imperative. One line in a narrow popover — must stay short.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use \"%@\" instead"
          }
        },

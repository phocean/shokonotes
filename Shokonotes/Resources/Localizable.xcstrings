    "Pick the iCloud Drive folder that holds your notes. Other Files locations are not supported.": {
      "comment": "Explanatory text on the iOS first-run screen, under the app name. \"iCloud Drive\" and \"Files\" are Apple's product names — use Apple's own localized names, and keep \"Files\" as the name of the Files app.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the iCloud Drive folder that holds your notes. Other Files locations are not supported."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le dossier iCloud Drive qui contient vos notes. Les autres emplacements de Fichiers ne sont pas pris en charge."

            "value": "No se ha podido mover la carpeta"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile spostare la cartella"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを移動できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 이동할 수 없음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mover a pasta"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法移动文件夹"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось переместить папку"
          }
        }
      }
    },
    "A folder cannot be moved into itself or into one of its own folders.": {
      "comment": "One of the possible message bodies of the \"Could not move the folder\" alert: the destination is the folder itself or one of its descendants. Full sentence.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A folder cannot be moved into itself or into one of its own folders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier ne peut pas être déplacé dans lui-même ni dans l’un de ses sous-dossiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ordner kann nicht in sich selbst oder in einen seiner Unterordner bewegt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una carpeta no se puede mover a sí misma ni a una de sus subcarpetas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cartella non può essere spostata in se stessa o in una delle sue sottocartelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを自分自身やその中のフォルダへ移動することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 자기 자신이나 그 안의 폴더로 옮길 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pasta não pode ser movida para si mesma nem para uma das suas subpastas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能将文件夹移入其自身或其子文件夹。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папку нельзя переместить в саму себя или в одну из своих папок."
          }
        }
      }
    },
    "A folder named “%@” is already there. Rename one of them, then move it again.": {
      "comment": "One of the possible message bodies of the \"Could not move the folder\" alert: the destination already contains a folder of that name. %@ is the folder's name; keep the typographic quotation marks around it, or replace them with the quotation marks your language uses.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A folder named “%@” is already there. Rename one of them, then move it again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dossier nommé « %@ » existe déjà à cet endroit. Renommez l’un des deux, puis déplacez-le à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ordner namens „%@“ ist dort bereits vorhanden. Benennen Sie einen um und bewegen Sie ihn erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay una carpeta llamada “%@”. Cambie el nombre de una y vuelva a moverla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "C’è già una cartella chiamata «%@». Rinomina una delle due, poi spostala di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」というフォルダはすでにそこにあります。どちらかの名前を変えてから、もう一度移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”라는 폴더가 이미 있습니다. 한쪽 이름을 바꾼 뒤 다시 옮기세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe uma pasta chamada “%@”. Renomeie uma delas e mova de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那里已有名为“%@”的文件夹。请先重命名其中一个，然后再移动。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка с именем «%@» уже есть. Переименуйте одну из них, затем переместите снова."
          }
        }
      }
    },
    "That destination cannot hold a folder.": {
      "comment": "One of the possible message bodies of the \"Could not move the folder\" alert: the drop target is not a place a folder can live. Full sentence.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That destination cannot hold a folder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette destination ne peut pas contenir de dossier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Ziel kann keinen Ordner aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese destino no puede contener una carpeta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella destinazione non può contenere una cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その移動先にはフォルダを置けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 위치에는 폴더를 둘 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse destino não pode conter uma pasta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该目标位置不能放置文件夹。"
          }
        },
        "ru": {

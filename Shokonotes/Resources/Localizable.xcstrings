    "Show the inbox count on the Dock icon": {
      "comment": "Toggle label in Settings > Appearance > Dock (macOS). When on, the number of notes in the Inbox is drawn as a badge on the app's Dock icon. \"inbox\" is the Inbox sidebar row.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the inbox count on the Dock icon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher le nombre de notes de la boîte de réception sur l’icône du Dock"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzahl der Notizen im Eingang auf dem Dock-Symbol anzeigen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar el recuento de la bandeja de entrada en el icono del Dock"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il conteggio di In arrivo sull’icona nel Dock"
          }
        },

    },
    "Shokonotes reads Markdown files from a folder you pick. Editing happens in your own editor.": {
      "comment": "Two-sentence explanation under the first-run heading \"Choose a notes folder\". \"Shokonotes\" is the app name, never translated; \"Markdown\" is the format's name. \"your own editor\" means the separate application the user edits in — this app never edits note bodies.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shokonotes reads Markdown files from a folder you pick. Editing happens in your own editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shokonotes lit les fichiers Markdown d’un dossier que vous choisissez. L’édition se fait dans votre éditeur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Shokonotes liest Markdown-Dateien aus einem Ordner, den Sie wählen. Das Bearbeiten erfolgt in Ihrem eigenen Editor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Shokonotes lee archivos Markdown de una carpeta que usted elige. La edición se hace en su propio editor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Shokonotes legge i file Markdown da una cartella che scegli tu. La modifica avviene nel tuo editor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shokonotesは、選択したフォルダのMarkdownファイルを読みます。編集はご自身のエディタで行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shokonotes는 선택한 폴더의 Markdown 파일을 읽습니다. 편집은 사용하시는 편집기에서 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Shokonotes lê arquivos Markdown de uma pasta que você escolhe. A edição acontece no seu próprio editor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Shokonotes 会从您选择的文件夹读取 Markdown 文件。编辑在您自己的编辑器中完成。"

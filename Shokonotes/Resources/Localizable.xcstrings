    "Choose the folder that holds your Markdown notes.": {
      "comment": "Message displayed inside the macOS folder-picker panel. One sentence, an instruction. \"Markdown\" is the file format's name and is not translated.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder that holds your Markdown notes."
          }
        },

            "value": "Shokonotes читает файлы Markdown из выбранной вами папки. Правка идёт в вашем редакторе."
          }
        }
      }
    },
    "Notes in the Trash are removed from disk when emptied.": {
      "comment": "Explanatory sentence in a banner at the top of the note list while the Trash is being viewed, beside the \"Empty\" button. \"emptied\" refers to emptying the Trash.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes in the Trash are removed from disk when emptied."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes de la corbeille sont effacées du disque lorsqu’elle est vidée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen im Papierkorb werden beim Leeren von der Festplatte entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas de la papelera se borran del disco al vaciarla."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note nel Cestino vengono rimosse dal disco quando lo si svuota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱を空にすると、中のメモはディスクから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통을 비우면 그 안의 메모가 디스크에서 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas no Lixo são removidas do disco ao esvaziá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清倒废纸篓时，其中的笔记会从磁盘上删除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметки в Корзине удаляются с диска при очистке."
          }
        }
      }
    },
    "%lld note(s) will be removed from disk. This cannot be undone.": {
      "comment": "Message body of the confirmation dialogs for emptying the Trash and for deleting notes permanently. %lld is the number of notes about to be erased. This entry already carries plural variations — translate the one/other forms (and add the forms your language needs), not the \"(s)\" key text.",

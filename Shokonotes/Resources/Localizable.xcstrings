    "Turns quotes and dashes into typographic forms in the preview only. Files are not modified.": {
      "comment": "Help text under the \"Smart punctuation\" toggle. It insists the files on disk are left alone — keep that reassurance explicit.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns quotes and dashes into typographic forms in the preview only. Files are not modified."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace guillemets et tirets par leurs formes typographiques dans l’aperçu seulement. Les fichiers ne sont pas modifiés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelt Anführungszeichen und Bindestriche nur in der Vorschau in typografische Formen um. Dateien werden nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte comillas y guiones en formas tipográficas solo en la previsualización. Los archivos no se modifican."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma virgolette e trattini in forme tipografiche solo nell’anteprima. I file non vengono modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用符とダッシュはプレビューでのみ組版用の形になります。ファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따옴표와 대시는 미리보기에서만 조판 형태로 바뀝니다. 파일은 수정되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",

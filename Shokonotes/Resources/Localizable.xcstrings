    "The preview theme changes colours and code highlighting. Files are not modified.": {
      "comment": "Help text under the preview Theme picker in Settings > Preview. \"code highlighting\" is the syntax colouring of code blocks. It insists the files on disk are left alone.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The preview theme changes colours and code highlighting. Files are not modified."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le thème de l’aperçu change les couleurs et la coloration du code. Les fichiers ne sont pas modifiés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Vorschaubild ändert Farben und Codehervorhebung. Dateien werden nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tema de previsualización cambia los colores y el resaltado del código. Los archivos no se modifican."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tema dell’anteprima cambia i colori e l’evidenziazione del codice. I file non vengono modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューのテーマは色とコードのハイライトを変えます。ファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기 테마는 색과 코드 강조를 바꿉니다. 파일은 수정되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tema da pré-visualização muda as cores e o realce de código. Os arquivos não são modificados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览主题会改变颜色和代码高亮。文件本身不会被修改。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема просмотра меняет цвета и подсветку кода. Файлы не изменяются."
          }
        }
      }
    },

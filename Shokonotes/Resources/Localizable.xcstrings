    "Choose the iCloud Drive folder that holds your notes. What you shared is kept until then.": {
      "comment": "Message shown on iOS when something was shared to the app before a notes folder had been picked: the shared item is held until the folder is chosen. \"iCloud Drive\" is Apple's service — use Apple's own localized name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the iCloud Drive folder that holds your notes. What you shared is kept until then."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le dossier iCloud Drive qui contient vos notes. Ce que vous avez partagé est conservé jusque-là."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den iCloud-Drive-Ordner, der Ihre Notizen enthält. Das Geteilte wird bis dahin aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la carpeta de iCloud Drive que contiene sus notas. Lo compartido se guarda hasta entonces."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la cartella di iCloud Drive che contiene le tue note. Quanto condiviso viene conservato fino ad allora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモが入っているiCloud Driveフォルダを選んでください。共有した内容はそれまで保管されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모가 들어 있는 iCloud Drive 폴더를 고르세요. 공유한 내용은 그때까지 보관됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a pasta do iCloud Drive que contém as suas notas. O que você compartilhou fica guardado até lá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择存放笔记的 iCloud 云盘文件夹。共享的内容会一直保留到那时。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку iCloud Drive с вашими заметками. Отправленное сохранится до тех пор."
          }
        }
      }
    }

    "The name becomes the file name. A YAML title is updated when present.": {
      "comment": "Help text under the field in the note rename sheet. \"file name\" is the name of the Markdown file on disk; \"YAML title\" is the title: line in the note's YAML front matter. Keep \"YAML\" as is.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name becomes the file name. A YAML title is updated when present."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom devient le nom de fichier. Un titre YAML est mis à jour s’il est présent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name wird zum Dateinamen. Ein YAML-Titel wird aktualisiert, falls vorhanden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre pasa a ser el nombre de archivo. Un título YAML se actualiza si existe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome diventa il nome del file. Un titolo YAML viene aggiornato se presente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前がファイル名になります。YAMLのtitleがある場合は更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름이 파일 이름이 됩니다. YAML 제목이 있으면 함께 업데이트됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome vira o nome do arquivo. Um título YAML é atualizado quando existe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该名称会成为文件名。若存在 YAML 标题，则会一并更新。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это имя становится именем файла. Заголовок YAML обновляется, если он есть."
          }
        }
      }
    },
    "Notes in “%@” will be moved to the Trash. This cannot be undone for the folder itself.": {
      "comment": "Message body of the \"Delete folder?\" confirmation dialog. %@ is the folder's name; keep the typographic quotation marks around it, or replace them with the quotation marks your language uses. Two sentences.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes in “%@” will be moved to the Trash. This cannot be undone for the folder itself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes de « %@ » iront à la corbeille. Le dossier lui-même sera supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notizen in „%@“ werden in den Papierkorb gelegt. Der Ordner selbst wird gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notas de “%@” irán a la papelera. La carpeta en sí se eliminará."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le note in «%@» andranno nel Cestino. La cartella stessa verrà eliminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」内のメモはゴミ箱に移されます。フォルダ自体は削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”의 메모는 휴지통으로 옮겨집니다. 폴더 자체는 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notas em “%@” irão para o Lixo. A pasta em si será apagada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 中的笔记将移到废纸篓。文件夹本身将被删除。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заметки из «%@» будут перемещены в Корзину. Сама папка будет удалена."
          }
        }
      }
    },
    "The folder is created in the selected directory, or in the notes folder.": {
      "comment": "Informative text of the macOS new-folder alert, under the name field. \"the notes folder\" is the library root chosen in Settings; it is the fallback when no folder is selected in the sidebar.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder is created in the selected directory, or in the notes folder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier est créé dans le répertoire sélectionné, ou dans le dossier de notes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner wird im ausgewählten Verzeichnis oder im Notizenordner erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta se crea en el directorio seleccionado o en la carpeta de notas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella viene creata nella directory selezionata o nella cartella delle note."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダは、選択中のディレクトリ、またはメモフォルダに作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더는 선택한 디렉토리 또는 메모 폴더에 만들어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta é criada no diretório selecionado ou na pasta de notas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件夹会创建在所选目录中，或创建在笔记文件夹中。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка создаётся в выбранном каталоге или в папке заметок."
          }
        }
      }
    },
